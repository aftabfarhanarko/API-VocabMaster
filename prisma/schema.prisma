datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  PHRASE
  IDIOM
}

enum SrsState {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

enum AccentType {
  US
  UK
}

enum QuizType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  AUDIO_LISTENING
  MATCHING_PAIRS
}

model User {
  id               String          @id @default(uuid())
  supabaseId       String?         @unique
  email            String          @unique
  passwordHash     String?
  refreshTokenHash String?
  fullName         String?
  avatarUrl        String?
  role             Role            @default(USER)
  dailyWordGoal    Int             @default(10)
  preferredAccent  AccentType      @default(US)
  targetLanguage   String          @default("bn")
  themePreference  String          @default("system")
  soundEnabled     Boolean         @default(true)
  autoPlayAudio    Boolean         @default(false)
  reminderEnabled  Boolean         @default(true)
  reminderTime     String          @default("20:00")
  currentStreak    Int             @default(0)
  longestStreak    Int             @default(0)
  lastActiveDate   DateTime?
  totalPoints      Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  userWords        UserWordProgress[]
  collections      Collection[]
  quizSessions     QuizSession[]
  activityLogs     DailyActivityLog[]
  notes            WordNote[]
  bookmarks        Bookmark[]
  auditLogs        AuditLog[]

  @@index([supabaseId])
  @@index([email])
}

model VocabularyWord {
  id               String          @id @default(uuid())
  word             String          @unique
  normalizedWord   String          @unique
  phoneticUk       String?
  phoneticUs       String?
  audioUkUrl       String?
  audioUsUrl       String?
  partOfSpeech     PartOfSpeech
  cefrLevel        CefrLevel       @default(B1)
  category         String
  englishMeaning   String
  banglaMeaning    String
  englishContext   String?
  banglaContext    String?
  examples         WordExample[]
  synonyms         String[]        @default([])
  antonyms         String[]        @default([])
  frequencyScore   Int             @default(50)
  isSystemWord     Boolean         @default(true)
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  userProgress     UserWordProgress[]
  collectionItems  CollectionItem[]
  notes            WordNote[]
  bookmarks        Bookmark[]

  @@index([word])
  @@index([cefrLevel])
  @@index([category])
  @@index([partOfSpeech])
}

model WordExample {
  id             String          @id @default(uuid())
  wordId         String
  sentenceEn     String
  sentenceBn     String
  source         String?
  createdAt      DateTime        @default(now())

  word           VocabularyWord  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  @@index([wordId])
}

model UserWordProgress {
  id             String            @id @default(uuid())
  userId         String
  wordId         String
  state          SrsState          @default(NEW)
  easinessFactor Float             @default(2.5)
  interval       Int               @default(0)
  repetition     Int               @default(0)
  lapses         Int               @default(0)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime          @default(now())
  history        ReviewHistory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           VocabularyWord    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, nextReviewAt])
  @@index([userId, state])
}

model ReviewHistory {
  id             String            @id @default(uuid())
  userProgressId String
  rating         Int
  interval       Int
  easinessFactor Float
  responseTimeMs Int?
  reviewedAt     DateTime          @default(now())

  userProgress   UserWordProgress  @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  @@index([userProgressId])
  @@index([reviewedAt])
}

model Collection {
  id             String            @id @default(uuid())
  userId         String
  name           String
  description    String?
  color          String?           @default("#4F46E5")
  icon           String?           @default("folder")
  isPublic       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CollectionItem[]

  @@unique([userId, name])
  @@index([userId])
}

model CollectionItem {
  id             String            @id @default(uuid())
  collectionId   String
  wordId         String
  addedAt        DateTime          @default(now())

  collection     Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  word           VocabularyWord    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([collectionId, wordId])
  @@index([collectionId])
  @@index([wordId])
}

model WordNote {
  id             String            @id @default(uuid())
  userId         String
  wordId         String
  content        String
  mnemonic       String?
  personalExample String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           VocabularyWord    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
}

model QuizSession {
  id              String            @id @default(uuid())
  userId          String
  quizType        QuizType
  totalQuestions  Int
  correctCount    Int
  scorePercentage Float
  durationSeconds Int
  completedAt     DateTime          @default(now())
  details         Json?

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([completedAt])
}

model DailyActivityLog {
  id             String            @id @default(uuid())
  userId         String
  date           String
  wordsReviewed  Int               @default(0)
  wordsLearned   Int               @default(0)
  quizzesTaken   Int               @default(0)
  timeSpentSec   Int               @default(0)
  goalReached    Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Bookmark {
  id             String            @id @default(uuid())
  userId         String
  wordId         String
  createdAt      DateTime          @default(now())

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           VocabularyWord    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId])
  @@index([wordId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // e.g. AUTH_LOGIN, AUTH_REGISTER, DAILY_GOAL_UPDATED, WORD_BOOKMARKED
  entity      String?  // e.g. USER, VOCABULARY, COLLECTION, QUIZ
  entityId    String?
  status      String   @default("SUCCESS") // SUCCESS, FAILURE, WARNING
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}


