# VocabMaster Backend Environment Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database URL (Neon / Supabase PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:password@ep-host.neon.tech/neondb?sslmode=require"

# Supabase Credentials
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-secret-key"
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"

# FreeDict API (Dictionary & Multi-language Translations)
FREEDICT_API_KEY="your-freedict-api-key"
FREEDICT_API_URL="https://freedict.com/api/v1"

# CORS Allowed Origin
CORS_ORIGIN="https://vocab-master-ivory-mu.vercel.app,http://localhost:3000"

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Native JWT Secrets & Cookie Authentication
JWT_ACCESS_SECRET="your-jwt-access-secret-min-32-characters"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-min-32-characters"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
